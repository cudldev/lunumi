{
  "name": "lunumi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run menu-reader:hosts && vitest run",
    "menu-reader:hosts": "node scripts/build-menu-reader-hosts.mjs",
    "menu-reader:dev": "npm run menu-reader:hosts && npx --yes wrangler@4.134.0 dev --config menu-reader-worker/wrangler.jsonc",
    "menu-reader:deploy": "npx --yes wrangler@4.134.0 deploy --config menu-reader-worker/wrangler.jsonc",
    "model:collect": "node scripts/collect-menu-training.mjs",
    "model:prepare": "node scripts/prepare-fndds-training.mjs",
    "model:train": "node training/menu-extractor/train.mjs",
    "data:helsinki": "node scripts/build-osm-food-data.mjs",
    "data:discover-feeds": "node scripts/discover-lunch-feeds.mjs",
    "data:apply-link-overrides": "node scripts/apply-restaurant-link-overrides.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dexie": "^4.0.8",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
